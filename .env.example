# 复制为 .env 后填写；不要提交真实值。
# 1. 必填：长期固定随机加密密钥（留空时 compose.yaml 会阻断启动以防误用占位符；示例生成：python -c "import secrets; print(secrets.token_urlsafe(32))"）
BRIDGE_SECRET_KEY=
# BRIDGE_SECRET_KEY_PREVIOUS=
BRIDGE_PORT=9099

# 2. 管理员口令：Docker 端口映射部署、远程访问或反代场景下，宿主机访问管理台必须配置此项！
#    （仅在本机直接运行 uvicorn 且直连 127.0.0.1 回环时可留空免密）
CONSOLE_ADMIN_PASSWORD=
# CONSOLE_ADMIN_TOKEN=
ADMIN_SESSION_TTL_SECONDS=604800
# ADMIN_COOKIE_SECURE=false

# SMSBower 主平台配置（也可在 Web 控制台《系统配置》中填写）
ACTIVE_PROVIDERS=smsbower
DEFAULT_PROVIDER=smsbower
SMSBOWER_BASE_URL=https://smsbower.page/stubs/handler_api.php
SMSBOWER_DEFAULT_COUNTRY=52
# SMSBOWER_API_KEY=
# ALLOW_CUSTOM_UPSTREAM_HOSTS=

# 对外 API 鉴权策略（false=兼容本机免密+带 Key 隔离；true=外部请求强制 X-API-Key/Bearer）
API_AUTH_REQUIRED=false
# CORS_ORIGINS=

# Webhook 出站白名单（默认仅允许公网 HTTPS，禁止内网/回环/元数据地址；内部接收方可显式放行）
# WEBHOOK_ALLOWED_HOSTS=my-bot.internal,127.0.0.1
WEBHOOK_ALLOW_PRIVATE_NETS=false
WEBHOOK_TIMEOUT_SECONDS=8

# 缓存与验证码留存策略
COUNTRY_CACHE_TTL_SECONDS=1800
PRICE_CACHE_TTL_SECONDS=10
SMS_CODE_RETENTION_HOURS=24
SMS_CODE_MASK_IN_HISTORY=true
LOG_LEVEL=INFO

# 可选插件：whatsapp_wa（默认关闭）与旧版 v0.2.0 /api/* 兼容路由
ENABLE_WA_PLUGIN=false
ENABLE_LEGACY_API=false
# WA_APP_URL=http://wa-app:8080
# WA_APP_AUTH_TYPE=basic
# WA_APP_API_TOKEN=
# WA_APP_API_USERNAME=admin
# WA_APP_API_PASSWORD=
